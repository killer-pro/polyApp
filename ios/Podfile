# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Spécification explicite des versions Firebase
  pod 'Firebase/Core'
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Storage'
  pod 'Firebase/Messaging'

  # Configuration spécifique d'Abseil
  pod 'abseil', '~> 1.20240116.0'

  # Installation des pods Flutter
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Configuration iOS de base
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # Désactiver Bitcode
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Construire pour la distribution
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'

      # Exclure l'architecture arm64 pour le simulateur
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'

      # Configuration spécifique pour Abseil
      if target.name.include?('abseil')
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -all_load'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)', 'COCOAPODS=1', 'ABSL_USES_EXTERNAL_STRING_VIEW=1']
      end

      # Configuration pour Firebase
      if target.name.include?('Firebase')
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
      end

      # Swift Version
      if target.respond_to?(:product_type) and target.product_type == "com.apple.product-type.framework"
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end

    # Configuration supplémentaire pour les problèmes de liaison
    if target.name == 'Pods-Runner'
      target.build_configurations.each do |config|
        # Force le chargement des symboles
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -ObjC'
      end
    end
  end

  # Fix pour les warnings de compilation
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      end
    end
  end

  # Correction des avertissements de versionnement
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['WRAPPER_EXTENSION'] == 'bundle'
        config.build_settings['DEVELOPMENT_TEAM'] = 'YOUR_TEAM_ID'
      end
    end
  end
end